<?xml version="1.0" encoding="utf-8"?>
<designspace format="3">
    <axes>
        <axis default="200" maximum="900" minimum="200" name="weight" tag="wght">
            <map input="200" output="0"/>   <!-- ExtraLight -->
            <map input="300" output="95"/>  <!-- Light -->
            <map input="350" output="153"/> <!-- Normal* -->
            <map input="400" output="210"/> <!-- Regular -->
            <map input="500" output="360"/> <!-- Medium -->
            <map input="600" output="510"/> <!-- SemiBold -->
            <map input="700" output="730"/> <!-- Bold -->
            <map input="900" output="1000"/><!-- Heavy -->
        </axis>
        <axis default="0" maximum="10" minimum="0" name="padding" tag="PADG"/>
    </axes>
    <sources>
        <source filename="ChironSungHKVF-padding0_weight0-Master.otf">
            <info copy="1"/>
            <location>
                <dimension name="padding" xvalue="0"/>
                <dimension name="weight" xvalue="0"/>
            </location>
        </source>
