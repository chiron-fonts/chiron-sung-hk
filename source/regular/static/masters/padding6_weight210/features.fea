## > Remote Merge Start: feature.numr,feature.dnom,feature.frac,feature.ordn,feature.sups,feature.subs,feature.sinf,feature.c2sc,feature.smcp,feature.case,feature.tnum,feature.onum,feature.pnum,feature.lnum,feature.zero,feature.ss01,feature.ss02 <
feature numr { # Numerators
        lookup NUMR {
            sub @SS_FIG_LINING_TAB by @SS_FIG_NUMR;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_NUMR;
        } NUMR;
    } numr;

feature dnom { # Denominators
        sub @SS_FIG_LINING_TAB by @SS_FIG_DNOM;
        sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_DNOM;
    } dnom;

feature frac { # Fractions
        @SS_SLASH = [ \42853 \42851 ];

        lookup NUMR;
        sub \42226 by \42853;
        sub @SS_FIG_NUMR \41001' by \42859;

        sub [ \42851 \42853 @SS_FIG_DNOM @SS_PUNCT_DNOM ] [ @SS_FIG_NUMR @SS_PUNCT_NUMR ]' by [ @SS_FIG_DNOM @SS_PUNCT_DNOM ];
        sub @SS_FIG_DNOM \42859 [ @SS_FIG_NUMR @SS_PUNCT_NUMR ]' by [ @SS_FIG_DNOM @SS_PUNCT_DNOM ];
    } frac;

feature ordn { # Ordinals
        lookup SUPERIOR_MINUSCULE {
            sub @SS_LAT_LC_BASIC by @SS_LAT_LCSUPS_BASIC;
            sub [ \41628 \41629 ] by [ \42791 \42793 ];
            sub \41713 by \42753;
        } SUPERIOR_MINUSCULE;
    } ordn;

feature sups { # Superscript
        lookup SUPERIOR_MINUSCULE;

        sub @SS_LAT_UC_BASIC by @SS_LAT_UCSUPS_BASIC;

        lookup SUPERIOR_NUMERALS_SORTS {
            sub @SS_FIG_LINING_TAB by @SS_FIG_SUPS;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_SUPS;
        } SUPERIOR_NUMERALS_SORTS;

        lookup SUPERIOR_SORTS {
            sub [ \42120 \42169 \42170 \42172 ] by [ \42299 \42300 \42303 \42304 ];
        } SUPERIOR_SORTS;

    } sups;

feature subs { # Subscript
        lookup INFERIOR {
            sub @SS_FIG_LINING_TAB by @SS_FIG_INF;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_SUBS;
        } INFERIOR;
    } subs;

feature sinf { # Scientific Inferiors
        lookup INFERIOR;
    } sinf;

feature c2sc { # caps to small caps
        sub @SS_LAT_UC_BASIC by @SS_LAT_SC_BASIC;
        sub @SS_LAT_UC_ACCENTED by @SS_LAT_SC_ACCENTED;
        sub @SS_LAT_UC_ADDL by @SS_LAT_SC_ADDL;
        sub \41374 by \44001;

        sub @SS_CYR_UC_BASIC by @SS_CYR_SC_BASIC;
        sub @SS_CYR_UC_EXTENDED by @SS_CYR_SC_EXTENDED;
        sub @SS_CYR_UC_BGR by @SS_CYR_SC_BGR;

        sub @SS_GRK_UC_BASIC by @SS_GRK_SC_BASIC;
        sub @SS_GRK_UC_ACCENTED by @SS_GRK_SC_ACCENTED;

        lookup NUMERALS_SC {
            sub @SS_FIG_LINING_TAB by @SS_FIG_SC;
        } NUMERALS_SC;

        sub @SS_PUNCT_SC_SRC by @SS_PUNCT_SC;

    } c2sc;

feature smcp { # lowercase to small caps
        sub @SS_LAT_LC_BASIC by @SS_LAT_SC_BASIC;
        sub @SS_LAT_LC_ACCENTED by @SS_LAT_SC_ACCENTED;
        sub @SS_LAT_LC_ADDL by @SS_LAT_SC_ADDL;
        sub [ \41725 \41728 \41734 \41874 \41872 \41893 \41991 \41995 ]
         by [ \41725 \41728 \41734 \41874 \41872 \41893 \41991 \41995 ];
        sub \41704 by \44019;
        # A substitution for napostrophe is missing - no obvious solution;

        sub @SS_CYR_LC_BASIC by @SS_CYR_SC_BASIC;
        sub @SS_CYR_LC_EXTENDED by @SS_CYR_SC_EXTENDED;
        sub @SS_CYR_LC_BGR by [ \44392 \44394 \44396 \44399 \44400 \44505 \44506 \44404 \44509 \44409 \44412 \44416 \44511 \44422 \44424 \44425 \44426 \44428 \44431 \44435 \44508 ];
        sub \43717 by \44391;
        sub \43715 by \44449;

        sub @SS_GRK_LC_BASIC by @SS_GRK_SC_BASIC;
        sub @SS_GRK_LC_ACCENTED by @SS_GRK_SC_ACCENTED;
        sub [ \43362 \43379 \43380 ]
         by [ \43362 \43379 \43380 ];

        lookup NUMERALS_SC;

    } smcp;

feature case { # case-sensitive forms
        sub @SS_CASE_SOURCE by @SS_CASE_TARGET;
        sub @SS_FIG_LINING_TAB by @SS_FIG_CASE;
        sub \43394 by \43395;
    } case;

feature tnum { # Tabular Figures
        sub @SS_FIG_LINING by @SS_FIG_LINING_TAB;
        sub @SS_FIG_OLDSTYLE by @SS_FIG_OLDSTYLE_TAB;
    } tnum;

feature onum { # Oldstyle Figures
        sub @SS_FIG_LINING by @SS_FIG_OLDSTYLE;
        sub @SS_FIG_LINING_TAB by @SS_FIG_OLDSTYLE_TAB;
    } onum;

feature pnum { # Proportional Figures
        sub @SS_FIG_LINING_TAB by @SS_FIG_LINING;
        sub @SS_FIG_OLDSTYLE_TAB by @SS_FIG_OLDSTYLE;
    } pnum;

feature lnum { # Lining Figures
        sub @SS_FIG_OLDSTYLE by @SS_FIG_LINING;
        sub @SS_FIG_OLDSTYLE_TAB by @SS_FIG_LINING_TAB;
    } lnum;

feature zero { # Slashed Zero
        sub \42012 by \42010;
        sub \42032 by \42030;
    } zero;

