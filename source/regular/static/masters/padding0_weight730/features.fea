            sub [ @SS_UC_ALL @SS_SC_ALL @SS_LC_ASCENDING_ALL ] @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
            sub [ @SS_UC_ALL @SS_SC_ALL @SS_LC_ASCENDING_ALL ] @SS_MARKS_CMB_BELOW @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
