            sub \41061 \43198 by \41644;
            sub \41090 \43198 by \41910;
            sub \41045 \43198 by \41410;
            sub \41063 \43196 by \41674; # The decomposition defined by Unicode is: 0067+0327

        } GLYPH_COMPOSITION_LAT_NONCONTEXTUAL;

