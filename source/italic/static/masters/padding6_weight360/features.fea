## > Remote Merge Start: feature.numr,feature.dnom,feature.frac,feature.ordn,feature.sups,feature.subs,feature.sinf,feature.case,feature.tnum,feature.onum,feature.pnum,feature.lnum,feature.zero,feature.ss01,feature.ss02,feature.ss03 <
feature numr { # Numerators
        lookup NUMR {
            sub @SS_FIG_LINING_TAB by @SS_FIG_NUMR;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_NUMR;
        } NUMR;
    } numr;

feature dnom { # Denominators
        sub @SS_FIG_LINING_TAB by @SS_FIG_DNOM;
        sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_DNOM;
    } dnom;

feature frac { # Fractions
        @SS_SLASH = [ \42811 \42810 ];

        lookup NUMR;
        sub \42238 by \42811;
        sub @SS_FIG_NUMR \41001' by \42818;

        sub [ \42810 \42811 @SS_FIG_DNOM @SS_PUNCT_DNOM ] [ @SS_FIG_NUMR @SS_PUNCT_NUMR ]' by [ @SS_FIG_DNOM @SS_PUNCT_DNOM ];
        sub @SS_FIG_DNOM \42818 [ @SS_FIG_NUMR @SS_PUNCT_NUMR ]' by [ @SS_FIG_DNOM @SS_PUNCT_DNOM ];
    } frac;

feature ordn { # Ordinals
        lookup SUPERIOR_MINUSCULE {
            sub @SS_LAT_LC_BASIC by @SS_LAT_LCSUPS_BASIC;
            sub [ \41628 \41629 ] by [ \42752 \42753 ];
            sub \41713 by \42693;
        } SUPERIOR_MINUSCULE;
    } ordn;

feature sups { # Superscript
        lookup SUPERIOR_MINUSCULE;


        lookup SUPERIOR_NUMERALS_SORTS {
            sub @SS_FIG_LINING_TAB by @SS_FIG_SUPS;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_SUPS;
        } SUPERIOR_NUMERALS_SORTS;

        lookup SUPERIOR_SORTS {
            sub [ \42133 \42180 \42182 \42183 ] by [ \42314 \42315 \42319 \42320 ];
        } SUPERIOR_SORTS;

    } sups;

feature subs { # Subscript
        lookup INFERIOR {
            sub @SS_FIG_LINING_TAB by @SS_FIG_INF;
            sub @SS_PUNCT_SMALL_FIG by @SS_PUNCT_SUBS;
        } INFERIOR;
    } subs;

feature sinf { # Scientific Inferiors
        lookup INFERIOR;
    } sinf;

feature case { # case-sensitive forms
        sub @SS_CASE_SOURCE by @SS_CASE_TARGET;
        sub @SS_FIG_LINING_TAB by @SS_FIG_CASE;
        sub \43361 by \43362;
    } case;

feature tnum { # Tabular Figures
        sub @SS_FIG_LINING by @SS_FIG_LINING_TAB;
        sub @SS_FIG_OLDSTYLE by @SS_FIG_OLDSTYLE_TAB;
    } tnum;

feature onum { # Oldstyle Figures
        sub @SS_FIG_LINING by @SS_FIG_OLDSTYLE;
        sub @SS_FIG_LINING_TAB by @SS_FIG_OLDSTYLE_TAB;
    } onum;

feature pnum { # Proportional Figures
        sub @SS_FIG_LINING_TAB by @SS_FIG_LINING;
        sub @SS_FIG_OLDSTYLE_TAB by @SS_FIG_OLDSTYLE;
    } pnum;

feature lnum { # Lining Figures
        sub @SS_FIG_OLDSTYLE by @SS_FIG_LINING;
        sub @SS_FIG_OLDSTYLE_TAB by @SS_FIG_LINING_TAB;
    } lnum;

feature zero { # Slashed Zero
        sub \42026 by \42024;
        sub \42048 by \42043;
    } zero;

