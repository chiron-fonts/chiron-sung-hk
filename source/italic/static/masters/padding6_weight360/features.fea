            sub \43121 \43163 by \43215;
            sub \43121 \43113 by \43219;
        } MARKS_COMPOSITION;

        lookup DECOMPOSE_PRECOMPOSED {
            sub [ @SS_UC_ACCENTED_DECOMP_ALL @SS_LC_ACCENTED_DECOMP_ALL ]' lookup DECOMPOSITION [ @SS_MARKS_CMB_ABOVE @SS_MARKS_CMB_BELOW ];
            sub [ \41067 \41069 \43567 \43570 ]' lookup SOFT_DOT @SS_MARKS_CMB_ABOVE;
            sub @SS_DOUBLE_MARKS' lookup MARKS_DECOMPOSITION @SS_MARKS_CMB_ABOVE;
        } DECOMPOSE_PRECOMPOSED;

        lookup CAP_ACCENTS_CMB_CONTEXT {
            # substitutes combining marks for minuscules with forms for uppercase
            sub [ @SS_UC_ALL @SS_LC_ASCENDING_ALL ] @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
            sub [ @SS_UC_ALL @SS_LC_ASCENDING_ALL ] @SS_MARKS_CMB_BELOW @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
            sub @SS_MARKS_CMB_ABOVE_CAP @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
            sub @SS_MARKS_CMB_ABOVE_CAP @SS_MARKS_CMB_BELOW @SS_MARKS_CMB_ABOVE' by @SS_MARKS_CMB_ABOVE_CAP;
        } CAP_ACCENTS_CMB_CONTEXT;

        lookup GLYPH_COMPOSITION_LAT_NONCONTEXTUAL {
            # Glyphs that would look odd or be wrong if composed only with combining accents.
            # The re-constructional substitution is mostly for InDesign.
            # Works as expected in InDesign (15.1.2), not in Chrome (86.0) or Safari (14.0).

            # For some reason, L|l|d + caron + dotbelowcmb/macronbelowcmb (in any order) will produce the wrong (and unattached) caron form in Chrome/Safari.

            sub \41059 \43144 by \41619;
            sub \41073 \43144 by \41738;
            sub \41089 \43144 by \41879;
            sub \41024 \43145 by \41227;
            sub \41063 \43113 by \41681;  # AL4
            sub \41015 \43116 by \41194;  # AL4
            sub \41061 \43152 by \41644;
            sub \41067 \43152 by \41710;
            sub \41019 \43152 by \41212;
            sub \41090 \43152 by \41910;
            sub \41045 \43152 by \41410;
            sub \41063 \43151 by \41674; # The decomposition defined by Unicode is: 0067+0327

        } GLYPH_COMPOSITION_LAT_NONCONTEXTUAL;

        # works but silly. The caron is duplicated in the end.
        # lookup CARON_RESHUFFLE {
