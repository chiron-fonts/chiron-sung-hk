        lookup DOUBLE_I_DIAERESIS { # substitutes alternate yi/idieresis in context
                sub [ \41703 \43568 ]' [ \41703 \43568 ] by [ \41704 \43670 ];
                sub [ \41704 \43670 ] [ \41703 \43568 ]' by [ \41704 \43670 ];
        } DOUBLE_I_DIAERESIS;

        lookup MARKS_COMPOSITION {
            sub \43135 \43107 by \43174;
            sub \43135 \43370 by \43373;
            sub \43135 \43097 by \43180;
            sub \43135 \43117 by \43184;
            sub \43135 \43144 by \43189;
